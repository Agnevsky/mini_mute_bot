# --- обязательное ---

# Токен бота от @BotFather
BOT_TOKEN=

# ID администраторов в виде JSON-списка, их нельзя замьютить
ADMIN_ID=[123456789]


# --- турнир (можно не заполнять, если нужен только мьют) ---

# true — включает регистрацию, таблицу и сайт. Требует запуска с
# docker-compose.tournament.yml, иначе бот не найдёт базу и упадёт.
ENABLE_TOURNAMENT=false

# DB_HOST=db  -> postgres из docker-compose.tournament.yml
# DB_HOST=host.docker.internal -> postgres, установленный на самом сервере
DB_HOST=db
DB_PORT=5432
DB_NAME=mute_bot
DB_USER=mute_bot
DB_PASSWORD=change_me
